{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "build.ps1: собирает libsofa.a (если нет) + tests/verify.exe и запускает. Ctrl+Shift+B."
    },
    {
      "label": "build current file (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1", "${relativeFile}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Собрать открытый tests/*.cpp тем же набором модулей (build.ps1)."
    },
    {
      "label": "build (Linux / Git Bash)",
      "type": "shell",
      "command": "sh",
      "args": ["build.sh", "tests/verify.cpp"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Тот же билд через sh-скрипт (Git Bash/Linux)."
    }
  ]
}
